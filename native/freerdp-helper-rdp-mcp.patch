-        --arch="$ARCH" \
-        --enable-shared \
-        --disable-static \
-        --disable-programs \
-        --disable-doc \
-        --disable-htmlpages \
-        --disable-manpages \
-        --disable-podpages \
-        --disable-txtpages \
-        --disable-network \
-        --disable-everything \
-        --enable-decoder=h264 \
-        --enable-decoder=hevc \
-        --enable-parser=h264 \
-        --enable-parser=hevc \
-        --enable-swscale \
-        --disable-xlib \
-        --disable-libxcb \
-        --extra-cflags="$EXTRA_CFLAGS" \
-        --extra-ldflags="$EXTRA_LDFLAGS" \
-        $FFMPEG_EXTRA_FLAGS
-
-    make -j"$NCPU"
-    make install
-    echo "  FFmpeg installed to $PREFIX"
-}
